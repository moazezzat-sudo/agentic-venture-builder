# =============================================================================
# Agentic Venture Builder - Environment Configuration (.env.example)
# Copy this file to .env and adjust values as needed.
# NEVER commit real secrets or live payment keys to the repository.
# =============================================================================

# --- Local / Free-Tier Model Settings ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
LLM_TEMPERATURE=0.2
LLM_COST_PER_1K_TOKENS=0.0

# Optional free-tier fallback API key (placeholder only - not required)
FREE_TIER_LLM_API_KEY=your_free_tier_api_key_placeholder_here

# --- Application & Pipeline Settings ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
OUTPUTS_DIR=./outputs
DECISION_LOG_PATH=./decision_log.json

# --- Founder Approval & Gate Controls ---
# Enforce explicit founder approve/reject step in CLI/UI before any publish, spend, or gate pass
REQUIRE_FOUNDER_APPROVAL=true
MIN_SOURCED_EVIDENCE_RATIO=0.5

# --- Sandbox / Mock Payment & Delivery Settings ---
# Allowed values: mock, sandbox (NEVER use live payment keys)
PAYMENT_MODE=mock
STRIPE_TEST_SECRET_KEY=sk_test_placeholder_only_do_not_use_live_keys
STRIPE_TEST_WEBHOOK_SECRET=whsec_test_placeholder_only
DELIVERY_TOKEN_SIGNING_KEY=dev_placeholder_delivery_signing_key_change_me
