# Copy to .env to change settings. Placeholders only: never commit a real key.
# Nothing here is required: without a Groq key the system runs fully locally with Ollama.

# --- Model ---
# auto (default): Groq free tier if GROQ_API_KEY is set, otherwise local Ollama.
# Other values: groq, ollama, openai_compatible
LLM_PROVIDER=auto

# Groq free tier (open-weight models). Create a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
LLM_MAX_RETRIES=6

# Local fallback (used when no Groq key is set)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
LLM_TEMPERATURE=0.2
LLM_COST_PER_1K_TOKENS=0

# Optional free-tier endpoint (only used when LLM_PROVIDER=openai_compatible)
OPENAI_COMPAT_BASE_URL=https://example-free-tier.invalid/v1
OPENAI_COMPAT_MODEL=placeholder-model-name
OPENAI_COMPAT_API_KEY=placeholder_key_do_not_commit_real_keys

# --- Paths ---
OUTPUTS_DIR=outputs
DECISION_LOG_PATH=decision_log.json
CACHE_DIR=.cache
CHECKPOINT_DB=.cache/checkpoints.sqlite

# Payments are MOCKED in code. There are no payment keys or payment settings.
