# Copy to .env to change settings. Placeholders only: never commit a real key.
# Nothing here is required: the system runs fully locally with Ollama and free tools.

# --- Model ---
# ollama: local open-weight model through Ollama (what the team runs and demos with).
# auto (the default when unset): Groq free tier if GROQ_API_KEY is set, otherwise Ollama.
# Other values: groq, openai_compatible
LLM_PROVIDER=ollama

# --- Local model (Ollama) ---
# Pull the model first: ollama pull qwen3:8b   (docker compose up does this for you)
OLLAMA_MODEL=qwen3:8b
# Model for light steps (role="fast"). Leave empty to use OLLAMA_MODEL for everything.
OLLAMA_FAST_MODEL=
# Where Ollama listens. Leave unset for the defaults:
#   - docker compose up (bundled ollama service):        http://ollama:11434
#   - app run directly on your machine (streamlit run):   http://localhost:11434
# Native Ollama (for example Ollama for Windows with a GPU) used from Docker on
# Windows or Mac: set the line below, then run: docker compose up --no-deps app
# (host.docker.internal also resolves outside Docker on Windows/Mac, so it works for both.)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# Context window in tokens (Ollama's default silently cuts long prompts).
OLLAMA_NUM_CTX=8192
# Default max tokens per reply; agents can set their own per call.
OLLAMA_NUM_PREDICT=800
# How long Ollama keeps the model loaded between calls.
OLLAMA_KEEP_ALIVE=30m
LLM_TEMPERATURE=0.2
# USD per 1,000 tokens: 0 for local models.
LLM_COST_PER_1K_TOKENS=0

# --- Optional: Groq free tier (open-weight models, used when LLM_PROVIDER=groq or auto) ---
# Create a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
LLM_MAX_RETRIES=6

# --- Optional free-tier endpoint (only used when LLM_PROVIDER=openai_compatible) ---
OPENAI_COMPAT_BASE_URL=https://example-free-tier.invalid/v1
OPENAI_COMPAT_MODEL=placeholder-model-name
OPENAI_COMPAT_API_KEY=placeholder_key_do_not_commit_real_keys

# --- Paths ---
# In Docker, DECISION_LOG_PATH is set by docker-compose.yml so the log lands in the repo folder.
OUTPUTS_DIR=outputs
DECISION_LOG_PATH=decision_log.json
CACHE_DIR=.cache
CHECKPOINT_DB=.cache/checkpoints.sqlite

# Payments are MOCKED in code. There are no payment keys or payment settings.
